<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TiendaMar - Pedidos</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body class="bg-light">

    <% /* ==================== HEADER RESPONSIVO ==================== */ %>
    <header class="bg-white border-bottom shadow-sm py-2 py-md-3 px-2 px-md-4">
        <div class="container-fluid px-1 px-md-5">
            
            <div class="d-flex align-items-center justify-content-between gap-2 gap-md-4">
                
                <% /* 1. LOGO */ %>
                <div class="d-flex align-items-center flex-shrink-0">
                    <img src="/img/logo.png" alt="Logo" class="img-fluid d-md-none" style="max-height: 32px; width: auto;">
                    <img src="/img/logo.png" alt="Logo" class="img-fluid d-none d-md-block" style="max-height: 80px; width: auto;">
                </div>

                <% /* 2. BARRA DE BÚSQUEDA */ %>
                <form action="/" method="GET" class="search-form flex-grow-1" style="max-width: 650px;">
                    <div class="input-group position-relative">
                        <span class="input-group-text bg-light border-end-0 text-secondary ps-2 ps-md-3 py-1 py-md-2">
                            <i class="bi bi-search" style="font-size: 0.9rem;"></i>
                        </span>
                        <input type="text" id="searchInput" name="busqueda" class="form-control bg-light border-start-0 text-secondary shadow-none py-1 py-md-2" style="font-size: 0.85rem; padding-right: 2rem;" placeholder="Buscar productos..." value="<%= busquedaActual %>">
                        <button type="button" id="clearSearchBtn" class="position-absolute top-50 end-0 translate-middle-y me-2 p-0 border-0 bg-transparent d-flex align-items-center justify-content-center <%= busquedaActual ? '' : 'd-none' %>" aria-label="Limpiar búsqueda" style="width: 20px; height: 20px;">
                            <i class="bi bi-x-circle-fill text-secondary" style="font-size: 1rem;"></i>
                        </button>
                    </div>
                </form>

                <% /* 3. BOTONES DERECHOS */ %>
                <div class="d-flex justify-content-center flex-shrink-0">
                    
                    <button type="button" class="btn boton_cuenta rounded-pill px-4 py-2 d-none d-md-flex align-items-center gap-2 shadow-sm">
                        <i class="bi bi-person-fill fs-5"></i>
                        <strong class="fs-6">Mi cuenta</strong>
                    </button>

                    <button type="button" id="mobileCartBtn" class="btn btn-primary rounded-circle d-flex d-md-none align-items-center justify-content-center shadow-sm position-relative" style="width: 38px; height: 38px; background: #1777c0; border: none;">
                        <i class="bi bi-cart3 text-white" style="font-size: 1.1rem;"></i>
                        <span class="position-absolute top-0 start-100 translate-middle bg-danger border border-light rounded-circle" style="width: 12px; height: 12px; padding: 0;">
                            <span class="visually-hidden">Nuevos ítems</span>
                        </span>
                    </button>

                </div>
            </div>

        </div>
    </header>

    <% /* ==================== CONTENIDO PRINCIPAL ==================== */ %>
    <main class="container-fluid px-3 px-md-5 my-4">
        <div class="row g-4">

            <% /* COLUMNA IZQUIERDA (Categorías + Productos) */ %>
            <div class="col-12 col-md-8 col-lg-9 d-flex flex-column">
            

                <% /* ==================== MENÚ DESPLEGABLE DE CATEGORÍAS  ==================== */ %>
                <div class="dropdown mb-3">
                    
                    <button class="btn boton_cuenta px-3 px-md-4 py-2 d-flex align-items-center gap-2 shadow-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-grid-fill"></i>
                        <strong class="fs-6">Categorías</strong>
                        <i class="bi bi-chevron-down ms-2 text-muted" style="font-size: 0.8rem;"></i>
                    </button>



                    <ul class="dropdown-menu shadow-lg border-light-subtle mt-2 py-2" style="min-width: 280px; border-radius: 12px;">
                        <% categories.forEach(cat => { %>
                        <a href = "?categoria=<%= cat.Id_categoria %>" class=" btn dropdown-item py-2 fw-medium text-secondary" type="button"><%= cat.nombre %></a>
                        <% }) %>
                        
                        
                        <li><hr class="dropdown-divider"></li>
                        <a href = "/" class="dropdown-item py-2 fw-medium text-secondary" type="button">Ver todos los departamentos</a>
                        
                    </ul>
                </div>

                <% /* Catálogo de Productos */ %>
                <div class="mt-4">
                    <div class="row row-cols-2 row-cols-md-2 row-cols-lg-4 g-2 g-md-3">
                        <% if (products.length === 0) { %>
                            <p class="no-results">No se encontraron productos para "<%= busquedaActual %>"</p>
                        <% } else { %>
                        <% products.forEach(prod => { %>
                            <div class="col">
                                <div class="card h-100 border-light-subtle rounded-4 shadow-sm p-2 p-md-3 position-relative d-flex flex-column justify-content-between">
                                    <div class="d-flex justify-content-center align-items-center bg-light rounded-3 p-2 mb-2 mb-md-3" style="height: 140px;">
                                        <img src= "<%= prod.imagen_url %>" alt="<%= prod.nombre %>" class="img-fluid" style="max-height: 100%; object-fit: contain;">
                                    </div>
                                    <div class="d-flex flex-column flex-grow-1 justify-content-between">
                                        <div>
                                            <small class="text-muted d-block mb-1" style="font-size: 0.75rem;">Cód: <%= prod.codigo %></small>
                                            <h6 class="fw-bold text-dark mb-2 fs-6" style="min-height: 2.4rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;"><%= prod.nombre %></h6>
                                        </div>
                                        <div class="mt-2 pt-2 border-top d-flex align-items-center justify-content-between flex-wrap gap-1">
                                            <div>
                                                <small class="text-muted d-block" style="font-size: 0.65rem;">Precio</small>
                                                <span class="fw-bold  fs-6 fs-md-5"><%= prod.precio_pieza %></span>
                                            </div>
                                            <button type="button" class="btn  rounded-pill px-2 px-md-3 py-1 text-white btn-sm d-flex align-items-center gap-1 shadow-sm" style="background: #1777c0; border: none;">
                                                <i class="bi bi-plus-lg"></i>
                                                <strong class="d-none d-sm-inline">Agregar</strong>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <% }) %>
                        <% } %>




                    </div>
                </div>

            </div>

            <% /* COLUMNA DERECHA (Panel de Pedido) */ %>
            <div class="d-none d-md-block col-md-4 col-lg-3 mt-5">
                <div class =" mt-5"> </div>
                <div class =" mt-2"> </div>
                

                <div class="card p-4 mb-3 rounded-4 shadow-lg d-flex flex-column" style="background: #fdead8b4; border: 1px solid #c95a0b93;">
                    <div class="d-flex align-items-center gap-2 pb-3 mb-3 w-100" style="border-bottom: 1px solid rgba(0, 0, 0, 0.1);">
                        <svg xmlns="http://www.w3.org/2000/svg" width="19" height="16" fill="currentColor" class="bi bi-cart3" viewBox="0 0 16 16">
                            <path d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .49.598l-1 5a.5.5 0 0 1-.465.401l-9.397.472L4.415 11H13a.5.5 0 0 1 0 1H4a.5.5 0 0 1-.491-.408L2.01 3.607 1.61 2H.5a.5.5 0 0 1-.5-.5M3.102 4l.84 4.479 9.144-.459L13.89 4zM5 12a2 2 0 1 0 0 4 2 2 0 0 0 0-4m7 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4m-7 1a1 1 0 1 1 0 2 1 1 0 0 1 0-2m7 0a1 1 0 1 1 0 2 1 1 0 0 1 0-2"/>
                        </svg>
                        <h5 class="mb-0">Pedido</h5>
                    </div>
                    
                    <div class="d-flex flex-column w-100 align-items-center text-center py-2">
                        <span class="text-body-tertiary fw-medium">Tu pedido está vacío</span>
                        <small class="text-body-tertiary">Agrega productos del catálogo</small>
                    </div>
                </div>

                <div class="card p-3 p-md-4 mb-3 rounded-4 shadow-sm recuadro-pago" style="background: #94cce9a7; border: 1px solid #0b77c993;">
                    <div class="d-flex align-items-start gap-2">
                        <i class="bi bi-shop-window fs-5 text-primary"></i>
                        <small class="text-dark">
                            Pago en tienda al momento de recoger tu pedido. Aceptamos efectivo y tarjeta.
                        </small>
                    </div>
                </div>

                <div class="d-grid">
                    <button class="btn btn-primary btn-lg rounded-pill fw-bold py-2 shadow-sm text-white" style="background: #1777c0; border: none;">
                        Hacer Pedido
                    </button>
                </div>

            </div>

        </div>
    </main>

    <% /* ==================== PANTALLA DE PEDIDO (MÓVIL) ==================== */ %>
    <div id="mobileOrderScreen" class="d-none d-md-none position-fixed top-0 start-0 w-100 h-100 bg-light" style="z-index: 1050; overflow-y: auto;">

        <div class="d-flex align-items-center gap-3 p-3 border-bottom bg-white shadow-sm">
            <button type="button" id="closeMobileOrderBtn" class="btn btn-light rounded-circle d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                <i class="bi bi-arrow-left fs-5"></i>
            </button>
            <h5 class="mb-0 fw-bold">Tu pedido</h5>
        </div>

        <div class="p-3">

            <div class="card p-4 mb-3 rounded-4 shadow-lg d-flex flex-column" style="background: #fdead8b4; border: 1px solid #c95a0b93;">
                <div class="d-flex align-items-center gap-2 pb-3 mb-3 w-100" style="border-bottom: 1px solid rgba(0, 0, 0, 0.1);">
                    <svg xmlns="http://www.w3.org/2000/svg" width="19" height="16" fill="currentColor" class="bi bi-cart3" viewBox="0 0 16 16">
                        <path d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .49.598l-1 5a.5.5 0 0 1-.465.401l-9.397.472L4.415 11H13a.5.5 0 0 1 0 1H4a.5.5 0 0 1-.491-.408L2.01 3.607 1.61 2H.5a.5.5 0 0 1-.5-.5M3.102 4l.84 4.479 9.144-.459L13.89 4zM5 12a2 2 0 1 0 0 4 2 2 0 0 0 0-4m7 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4m-7 1a1 1 0 1 1 0 2 1 1 0 0 1 0-2m7 0a1 1 0 1 1 0 2 1 1 0 0 1 0-2"/>
                    </svg>
                    <h5 class="mb-0">Pedido</h5>
                </div>

                <div class="d-flex flex-column w-100 align-items-center text-center py-2">
                    <span class="text-body-tertiary fw-medium">Tu pedido está vacío</span>
                    <small class="text-body-tertiary">Agrega productos del catálogo</small>
                </div>
            </div>

            <div class="card p-3 p-md-4 mb-3 rounded-4 shadow-sm recuadro-pago" style="background: #94cce9a7; border: 1px solid #0b77c993;">
                <div class="d-flex align-items-start gap-2">
                    <i class="bi bi-shop-window fs-5 text-primary"></i>
                    <small class="text-dark">
                        Pago en tienda al momento de recoger tu pedido. Aceptamos efectivo y tarjeta.
                    </small>
                </div>
            </div>

            <div class="d-grid">
                <button class="btn btn-primary btn-lg rounded-pill fw-bold py-2 shadow-sm text-white" style="background: #1777c0; border: none;">
                    Hacer Pedido
                </button>
            </div>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/main.js"></script>
</body>
</html>