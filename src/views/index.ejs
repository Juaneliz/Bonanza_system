<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TiendaMar - Pedidos</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="/css/styles.css">
</head>
    <body class="bg-light">

       <header class="bg-white border-bottom shadow-sm py-3 px-3">
            <div class="container-fluid d-flex align-items-center justify-content-between px-5">
                
                <div class="d-flex align-items-center">
                    <img src="/img/logo.png" alt="Logo" class="img-fluid" style="height: 55px; width: auto;">
                </div>

                

                <div class="flex-grow-1 ms-3 d-none d-md-block" style="max-width: 650px;">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-secondary ps-3">
                            <i class="bi bi-search fs-5"></i>
                        </span>
                        <input type="text" class="form-control bg-light border-start-0 text-secondary shadow-none py-2 fs-6" placeholder="Buscar productos, categorías o códigos...">
                    </div>
                </div>

                <div class="d-flex justify-content-center mx-3">
                    <button type="button" class="btn boton_cuenta rounded-pill btn-lg px-4 py-2 d-flex align-items-center gap-2 shadow-sm">
                        <i class="bi bi-person-fill fs-5"></i>
                        <strong class="fs-6">Mi cuenta</strong>
                    </button>
                </div>

            </div>
        </header>

       

        <main class="container px-1 px-md-4 my-4 ">

            <div class = "row">
                <div class=" col-8  d-flex flex-column">
                

                    <div class ="d-flex flex-nowrap gap-3">
                        <button type="button" class="btn  boton_cuenta px-4 py-2 d-flex  gap-2 shadow order-1 gap-2 ">
                                <i class="bi bi-chevron-compact-down"></i>
                                <strong class="fs-6"> Categorías</strong>
                        </button>

                        <button type="button" class="btn  border-light-subtle px-4 py-2 d-flex  gap-2 shadow-sm order-2 boton-interactivo">
                                <strong class="fs-6 ">Farmacia</strong>
                        </button>

                        <button type="button" class="btn  border-light-subtle px-4 py-2 d-flex  gap-2 shadow-sm order-2 boton-interactivo">
                                <strong class="fs-6">Higiene personal</strong>
                        </button>

                        <button type="button" class="btn  border-light-subtle px-4 py-2 d-flex  gap-2 shadow-sm order-2 boton-interactivo">
                                <strong class="fs-6">Limpieza</strong>
                        </button>

                        <button type="button" class="btn  border-light-subtle px-4 py-2 d-flex  gap-2 shadow-sm order-2 boton-interactivo">
                                <strong class="fs-6">Abarrotes</strong>
                        </button>

                    </div>

                </div>

                <div class="col-4">


                   <div class="card p-4 mb-4 rounded-4 shadow-lg d-flex flex-column" style="background: #fdead8b4; border: 1px solid #c95a0b93;">
    
                        <div class="d-flex align-items-center gap-2 pb-3 mb-3 w-100" style="border-bottom: 1px solid rgba(0, 0, 0, 0.1);">
                            <svg xmlns="http://www.w3.org/2000/svg" width="19" height="16" fill="currentColor" class="bi bi-cart3" viewBox="0 0 16 16">
                                <path d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .49.598l-1 5a.5.5 0 0 1-.465.401l-9.397.472L4.415 11H13a.5.5 0 0 1 0 1H4a.5.5 0 0 1-.491-.408L2.01 3.607 1.61 2H.5a.5.5 0 0 1-.5-.5M3.102 4l.84 4.479 9.144-.459L13.89 4zM5 12a2 2 0 1 0 0 4 2 2 0 0 0 0-4m7 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4m-7 1a1 1 0 1 1 0 2 1 1 0 0 1 0-2m7 0a1 1 0 1 1 0 2 1 1 0 0 1 0-2"/>
                            </svg>
                            <h5 class="mb-0">Pedido</h5>
                        </div>
                        
                        <div class="d-flex flex-column w-100">

                        </div>

                    </div>
            </div>
        </main>
    </body>
</html>